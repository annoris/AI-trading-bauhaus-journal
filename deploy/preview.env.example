# Copy to .env.preview at the repository root; never commit the populated file.
# Supply a strong password and an independent persistent encryption secret.
# The compose command refuses to start when either value is empty.
JOURNAL_PASSWORD=
JOURNAL_SECRET=
JOURNAL_PUBLIC_ORIGIN=https://journal.example.com

# Independent random proxy secret, at least 32 characters; also set in Caddy service env.
JOURNAL_PROXY_TOKEN=
JOURNAL_DEPLOYMENT_MODE=hosted
