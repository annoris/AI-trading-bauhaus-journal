# Most settings are optional. Invite-only multi-user mode requires JOURNAL_PASSWORD.

# Require a password to open the journal (recommended when exposed beyond localhost).
# JOURNAL_PASSWORD=

# Enable owner-issued, invite-only member accounts with a separate SQLite journal per member.
# When enabled, the root and /demo pages remain public and show only synthetic preview data.
# JOURNAL_MULTI_USER=true

# Encryption key source for broker credentials at rest.
# Default: a random key file generated next to the database.
# JOURNAL_SECRET=

# Where the SQLite database lives. Default: ./data
# JOURNAL_DATA_DIR=

# AI features (session recaps, trade critiques, ask-your-journal).
# Can also be set on the Settings page (stored encrypted).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# If only OPENAI_API_KEY is set, OpenAI is selected automatically.
# If both keys are set, Anthropic stays the default until you choose a provider in Settings.
# In invite-only multi-user mode, environment keys are owner-only. Members and the public demo
# must configure their own keys in their journal settings. Owner environment keys take precedence.

# Optional market data: no provider is configured or enabled by this template.
# Choose a connection or upload candle CSVs in Settings > Market data.
# Provider-specific environment configuration is documented in docs/market-data.md.

# Public HTTPS origin when running behind a reverse proxy.
# Set this explicitly in hosted deployments; do not trust arbitrary forwarded headers.
# JOURNAL_PUBLIC_ORIGIN=https://journal.example.com

# Hosted mode refuses incomplete security configuration.
# JOURNAL_DEPLOYMENT_MODE=hosted
# Trusted reverse-proxy secret (independent, random, at least 32 characters).
# Set the same value in the Caddy service environment; never expose to the browser.
# JOURNAL_PROXY_TOKEN=
