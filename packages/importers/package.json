{
  "name": "@trading-bauhaus/journal-importers",
  "private": true,
  "version": "0.1.0",
  "description": "Internal statement and export importers for Trading Bauhaus: broker CSVs, MetaTrader HTML statements, and journal migrations.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "trading",
    "trade-journal",
    "csv",
    "import",
    "tradezella",
    "tradervue",
    "broker-statement"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "dependencies": {
    "@trading-bauhaus/journal-core": "workspace:*"
  }
}
